# =====================================================================
# CLOSER — Variables d'environnement
# Copier ce fichier vers `.env` (jamais committer le `.env`).
# Aucune valeur réelle ne doit se trouver dans le dépôt.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Base de données — Supabase PostgreSQL (jamais localhost en prod)
#    Supabase > Project Settings > Database > Connection string (URI)
#    Utiliser le "Session pooler" (port 6543) sur Vercel / serverless.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Connexion directe (port 5432) — utilisée UNIQUEMENT par drizzle-kit pour les migrations
DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------
# 2. Application
# ---------------------------------------------------------------------
APP_ENV=development            # development | production
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false                # true = données de démonstration autorisées, false = production stricte

# ---------------------------------------------------------------------
# 3. Authentification
# ---------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Clé de chiffrement des identifiants WhatsApp/Instagram (distincte de JWT_SECRET)
# openssl rand -base64 48
CREDENTIALS_ENCRYPTION_KEY=

# Identifiants du compte administrateur plateforme (créé au premier seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# 4. IA — Google Gemini (strictement côté serveur)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7
# Filet de sécurité si l'IA ne répond pas / n'est pas configurée
AI_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------
# 5. Paiement — fournisseur marocain (Payzone / NAPS / autre)
#    PAS de Stripe. Laisser vide = "Fournisseur de paiement non configuré".
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=none          # none | payzone | naps
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=MAD
PAYMENT_SUCCESS_URL=${APP_URL}/billing/success
PAYMENT_CANCEL_URL=${APP_URL}/billing/cancel

# ---------------------------------------------------------------------
# 6. WhatsApp Cloud API (officielle — aucun scraping / WhatsApp Web)
#    Laisser vide = "WhatsApp non connecté"
# ---------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------
# 7. Instagram Messaging API (officielle)
#    Laisser vide = "Instagram non connecté"
# ---------------------------------------------------------------------
INSTAGRAM_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# ---------------------------------------------------------------------
# 8. Automations (relances)
# ---------------------------------------------------------------------
# Vercel Cron appelle cette route avec ce secret
CRON_SECRET=
AUTOMATION_BATCH_SIZE=50

# ---------------------------------------------------------------------
# 9. Sécurité / limitation de débit
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# ---------------------------------------------------------------------
# 10. Observabilité (optionnel)
# ---------------------------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error — ne JAMAIS journaliser les secrets
